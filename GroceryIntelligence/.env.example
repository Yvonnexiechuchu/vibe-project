# Anthropic API
ANTHROPIC_API_KEY=sk-ant-...

# Google Sheets — OAuth2 refresh-token auth.
#   1. In Google Cloud Console, create OAuth 2.0 Client ID (type: Web application),
#      add http://localhost:3040/callback as a redirect URI.
#   2. Paste the client ID + secret below.
#   3. Run `npm run oauth-setup` to get a refresh token in your browser.
#   4. Run `npm run create-sheet` to create the sheet in your Drive.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_SHEET_ID=
